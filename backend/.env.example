# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# Select a model currently enabled for your Groq account: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# PostgreSQL connection. Replace the password with your own local password.
DATABASE_URL=postgresql+psycopg://researchpilot:your_own_password@localhost:5432/researchpilot
# Use a random secret with at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=72
FRONTEND_ORIGIN=http://localhost:5173
# Keep this small on low TPM Groq tiers.
MAX_SEARCH_RESULTS=4
